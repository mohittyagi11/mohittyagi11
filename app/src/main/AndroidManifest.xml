<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications (Android 13+). Reminders are the whole point. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Survive reboots: re-arm all triggers. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Download an on-device model file (a file fetch, not a cloud LLM call). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Day-data sources: Health Connect (read-only, on-device). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!-- Optional phone-usage signal (DeviceUsageSource); granted in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Wake inference: activity recognition + Google Sleep API. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Geofencing: foreground + background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Health Connect provider visibility. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".DoseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dose">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect asks us to show why we read the data. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The unified add-item flow (typed / link / scan). Launched internally and by the
             share trampoline below; runs in its own task so the action bar is never hidden. -->
        <activity
            android:name=".ui.add.AddItemActivity"
            android:exported="false"
            android:label="Add to Dose"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.add"
            android:theme="@style/Theme.Dose" />

        <!-- The external "Add to Dose" share target. An invisible trampoline in its OWN task:
             it hands the shared link to AddItemActivity in Dose's task (brought to the front),
             so the add flow never opens buried inside the sharing app (e.g. Amazon). -->
        <activity
            android:name=".ui.add.ShareReceiverActivity"
            android:exported="true"
            android:label="Add to Dose"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Health Connect rationale on Android 14+. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Camera-scan captures: the system camera writes the photo here. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Logs a "Taken" tap straight from the notification, no UI. -->
        <receiver
            android:name=".receiver.TakenActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.quietdose.action.TAKEN" />
            </intent-filter>
        </receiver>

        <!-- Event triggers: windowed alarms + wake fallback + daily re-arm. -->
        <receiver android:name=".trigger.AlarmReceiver" android:exported="false" />
        <!-- Wake signals (explicit intents from our own scheduling). -->
        <receiver android:name=".trigger.ActivityReceiver" android:exported="false" />
        <receiver android:name=".trigger.SleepReceiver" android:exported="false" />
        <!-- Home geofence ENTER/EXIT. -->
        <receiver android:name=".trigger.GeofenceReceiver" android:exported="false" />
        <!-- Re-arm everything after reboot. -->
        <receiver
            android:name=".trigger.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
