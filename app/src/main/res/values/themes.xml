<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base platform theme; the real theming lives in Compose (ui/theme).
         windowBackground is night-aware (see values-night) so the window
         doesn't flash a light colour before Compose draws in dark mode. -->
    <style name="Theme.AzadiShashn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
</resources>
