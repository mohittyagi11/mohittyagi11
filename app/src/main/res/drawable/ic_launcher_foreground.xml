    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Four ascending bars — the four ideologies as a stark chrome chart.
         Brushed duotone metal, razor-fine bevel edges. Safe zone (y 24..84). -->

    <!-- baseline rule -->
    <path android:strokeColor="#7E8A99" android:strokeWidth="1.4"
        android:pathData="M26,80 L82,80" />

    <!-- bar 1 (Capitalist) -->
    <path android:strokeColor="#2C333F" android:strokeWidth="1" android:pathData="M28,58 h10 v22 h-10 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="34" android:endX="54" android:endY="82">
                <item android:offset="0.0" android:color="#EDF2F8" />
                <item android:offset="0.5" android:color="#A6B2C0" />
                <item android:offset="1.0" android:color="#586574" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- bar 2 (Supremo) -->
    <path android:strokeColor="#2C333F" android:strokeWidth="1" android:pathData="M42,46 h10 v34 h-10 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="34" android:endX="54" android:endY="82">
                <item android:offset="0.0" android:color="#EDF2F8" />
                <item android:offset="0.5" android:color="#A6B2C0" />
                <item android:offset="1.0" android:color="#586574" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- bar 3 (Showstopper) -->
    <path android:strokeColor="#2C333F" android:strokeWidth="1" android:pathData="M56,38 h10 v42 h-10 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="34" android:endX="54" android:endY="82">
                <item android:offset="0.0" android:color="#EDF2F8" />
                <item android:offset="0.5" android:color="#A6B2C0" />
                <item android:offset="1.0" android:color="#586574" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- bar 4 (Idealist) -->
    <path android:strokeColor="#2C333F" android:strokeWidth="1" android:pathData="M70,50 h10 v30 h-10 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="34" android:endX="54" android:endY="82">
                <item android:offset="0.0" android:color="#EDF2F8" />
                <item android:offset="0.5" android:color="#A6B2C0" />
