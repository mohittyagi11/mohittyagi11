<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- One fine champagne-gold ring with a single point at its centre. Two-tone,
         restrained — a quiet seal. Within the 66dp safe zone (r=28 of centre 54). -->

    <!-- the ring (thin stroke, subtle metallic sheen top→bottom) -->
    <path
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M26,54 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 z">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="26"
                android:endX="54" android:endY="82"
                android:startColor="#F1DCA0" android:endColor="#C29A53" />
        </aapt:attr>
    </path>

    <!-- the single centred point -->
    <path android:fillColor="#E6C982"
        android:pathData="M49.5,54 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 z" />
</vector>
