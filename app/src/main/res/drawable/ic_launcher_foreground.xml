<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- "The wheel of debate": one luminous ring whose colour flows continuously
         through the four ideology hues (a sweep/conic gradient) and converges on
         a bright core. Abstract, single mark — not four objects. Safe zone: the
         ring sits within radius 33 of centre (54,54). -->

    <!-- soft outer halo -->
    <path android:pathData="M16,54 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="40"
                android:startColor="#22FFFFFF" android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- the colour-flow ring (donut via even-odd) -->
    <path
        android:fillType="evenOdd"
        android:pathData="M21,54 a33,33 0 1,0 66,0 a33,33 0 1,0 -66,0 z M39,54 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="sweep" android:centerX="54" android:centerY="54">
                <item android:offset="0.00" android:color="#FFCA28" />
                <item android:offset="0.25" android:color="#FF6E6E" />
                <item android:offset="0.50" android:color="#9E7BFF" />
                <item android:offset="0.75" android:color="#2EE6C6" />
                <item android:offset="1.00" android:color="#FFCA28" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- inner shading on the ring's hole for depth -->
    <path android:pathData="M39,54 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="16"
                android:startColor="#000B0E22" android:endColor="#660B0E22" />
        </aapt:attr>
    </path>

    <!-- luminous convergence core -->
    <path android:pathData="M44,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="12"
                android:startColor="#F7FFFFFF" android:endColor="#1FFFFFFF" />
        </aapt:attr>
    </path>
</vector>
