<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Four glossy ideology orbs orbiting a luminous core, ringed — the four
         ideologies converging. Kept inside the 66dp safe zone. -->

    <!-- subtle orbit ring -->
    <path android:strokeColor="#2EFFFFFF" android:strokeWidth="2" android:fillColor="#00000000"
        android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 z" />

    <!-- top: Capitalist gold -->
    <path android:pathData="M36,36 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="48" android:centerY="30" android:gradientRadius="27"
                android:startColor="#FFF1C4" android:endColor="#F2B300" />
        </aapt:attr>
    </path>
    <!-- right: Supremo red -->
    <path android:pathData="M54,54 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="66" android:centerY="48" android:gradientRadius="27"
                android:startColor="#FFD2D2" android:endColor="#F0554F" />
        </aapt:attr>
    </path>
    <!-- bottom: Showstopper teal -->
    <path android:pathData="M36,72 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="48" android:centerY="66" android:gradientRadius="27"
                android:startColor="#C9FBF1" android:endColor="#14C7A6" />
        </aapt:attr>
    </path>
    <!-- left: Idealist purple -->
    <path android:pathData="M18,54 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="30" android:centerY="48" android:gradientRadius="27"
                android:startColor="#E4D8FF" android:endColor="#7E5AE6" />
        </aapt:attr>
    </path>

    <!-- luminous convergence core -->
    <path android:pathData="M43,54 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="13"
                android:startColor="#F5FFFFFF" android:endColor="#26FFFFFF" />
        </aapt:attr>
    </path>
</vector>
